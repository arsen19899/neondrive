<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Медиа -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- GPS-спидометр -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Состояние вызова, чтобы вернуть музыку после разговора -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.ANSWER_PHONE_CALLS" />

    <!-- Автозапуск оболочки после включения ГУ -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Панели оболочки поверх запущенной навигации -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!--
         Включение freeform-режима прошивки, без которого навигацию нельзя показать
         на половине экрана (см. nav/FreeformSetup.kt). Разрешение защищено уровнем
         signature|privileged — система его обычному приложению НЕ выдаст, и это
         нормально: объявление здесь нужно лишь для того, чтобы разрешение можно
         было выдать вручную одной командой с компьютера —
         adb shell pm grant com.neondrive.launcher android.permission.WRITE_SECURE_SETTINGS
         Без выданного разрешения объявление ни на что не влияет и ничего не ломает:
         оболочка просто пойдёт другим путём (root или подсказка с командой adb).
    -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <!-- Контакты в экране телефона -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <!-- Bluetooth: определяем подключённый телефон -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <package android:name="ru.yandex.yandexnavi" />
        <package android:name="ru.yandex.yandexmaps" />
        <package android:name="ru.yandex.music" />
    </queries>

    <application
        android:name=".NeonApp"
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="false"
        android:hardwareAccelerated="true"
        android:largeHeap="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.NeonDrive">

        <!-- ГЛАВНЫЙ ЭКРАН: полноценная замена рабочего стола ГУ -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:clearTaskOnLaunch="true"
            android:stateNotNeeded="true"
            android:screenOrientation="unspecified"
            android:resizeableActivity="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode|density|fontScale"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.NeonDrive">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.MONKEY" />
            </intent-filter>
            <!-- Некоторые ГУ шлют свой «домой» -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.CAR_DOCK" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Прозрачная активити-приёмник кнопок руля, когда лаунчер в фоне -->
        <activity
            android:name=".input.SwcCaptureActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.Transparent" />

        <!-- Плеер -->
        <service
            android:name=".media.PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>

        <!-- Слушатель уведомлений: пауза/приглушение при уведомлениях с телефона -->
        <service
            android:name=".automation.NeonNotificationListener"
            android:exported="true"
            android:label="@string/notif_listener_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Фоновая автоматика: скорость, звонки, кнопки руля -->
        <service
            android:name=".automation.AutomationService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!--
             Свой экран звонка вместо системного «Телефона» (см. CallOverlay).
             android.telecom.InCallService — тот же официальный механизм, которым
             Android Auto и подобные автомобильные оболочки показывают звонок
             своим интерфейсом, не становясь при этом приложением-телефоном
             по умолчанию. IN_CALL_SERVICE_CAR_MODE_UI сообщает Telecom, что
             сервис умеет рисовать экран звонка в автомобильном режиме —
             NeonApp включает этот режим (UiModeManager.enableCarMode) при
             старте оболочки, раз она и есть замена рабочего стола ГУ.
             android:permission обязателен и защищён системой — сторонний
             компонент не может забиндиться к сервису напрямую.
        -->
        <service
            android:name=".phone.NeonInCallService"
            android:exported="true"
            android:permission="android.permission.BIND_INCALL_SERVICE">
            <meta-data
                android:name="android.telecom.IN_CALL_SERVICE_UI"
                android:value="false" />
            <meta-data
                android:name="android.telecom.IN_CALL_SERVICE_CAR_MODE_UI"
                android:value="true" />
            <intent-filter>
                <action android:name="android.telecom.InCallService" />
            </intent-filter>
        </service>

        <!-- Панели оболочки поверх карты -->
        <service
            android:name=".overlay.NeonOverlayService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Панели автомобильной оболочки поверх навигации" />
        </service>

        <receiver
            android:name=".automation.BootReceiver"
            android:exported="true">
            <intent-filter android:priority="1000">
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

        <!-- Подача питания (зажигание) — оболочка выходит на передний план так же,
             как при пробуждении экрана -->
        <receiver
            android:name=".automation.PowerConnectedReceiver"
            android:exported="true">
            <intent-filter android:priority="1000">
                <action android:name="android.intent.action.ACTION_POWER_CONNECTED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".input.MediaButtonReceiver"
            android:exported="true">
            <intent-filter android:priority="2147483647">
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
